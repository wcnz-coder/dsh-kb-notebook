{
  "name": "dsh-kb-notebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Knowledge-base notebooks for DeepSeek Harness: import datasets, bind them to a conversation, answer strictly from them with citations.",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "client.js",
    "lib",
    "demo",
    "test",
    "README.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
